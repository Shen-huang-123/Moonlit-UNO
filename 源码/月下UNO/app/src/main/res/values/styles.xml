<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101E2B</item>
        <item name="android:navigationBarColor">#101E2B</item>
        <item name="android:colorAccent">#DFC591</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:alertDialogTheme">@style/MoonDialog</item>
    </style>
    <style name="MoonDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">#DFC591</item>
        <item name="android:textColorPrimary">#F1E8D6</item>
        <item name="android:textColorSecondary">#ADBEC5</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
